{
  "manifest_version": 3,
  "name": "SafeSwitch",
  "description": "Context-preserving environment manager with visual safety indicators.",
  "version": "1.0.3",
  "permissions": ["storage", "activeTab", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  }
}
