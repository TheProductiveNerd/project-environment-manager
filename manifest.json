{
  "manifest_version": 3,
  "name": "Project Environment Manager",
  "description": "Manage multiple projects and their environments with ease. Detect, display, and switch between environment URLs.",
  "version": "1.0.0",
  "permissions": ["storage", "activeTab", "scripting", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "64": "src/icons/icon-64.png",
      "128": "src/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["src/content.css"],
      "js": ["src/content.js"],
      "all_frames": false,
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "src/icons/icon-16.png",
    "64": "src/icons/icon-64.png",
    "128": "src/icons/icon-128.png"
  }
}
